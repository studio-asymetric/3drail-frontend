FROM node:22-alpine

WORKDIR /app

COPY proxy/*.mjs ./
RUN npm install --omit=dev pbf @mapbox/vector-tile
RUN mkdir -p /data/osm-cache

ENV PROXY_PORT=3001
ENV OSM_CACHE_DIR=/data/osm-cache
ENV PROXY_CACHE_FILE=/data/cache.json
ENV PROXY_LOG_FILE=/data/proxy.log

EXPOSE 3001

CMD ["node", "server.mjs"]
