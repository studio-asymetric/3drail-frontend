FROM node:22-alpine

WORKDIR /app

COPY proxy/server.mjs ./server.mjs
COPY proxy/simplifyRail.mjs ./simplifyRail.mjs
COPY proxy/maptilerRails.mjs ./maptilerRails.mjs
COPY proxy/trainDetail.mjs ./trainDetail.mjs
RUN npm install --omit=dev pbf @mapbox/vector-tile
COPY proxy/osm-cache ./osm-cache

RUN mkdir -p /app/osm-cache

ENV PROXY_PORT=3001
ENV OSM_CACHE_DIR=/app/osm-cache
ENV PROXY_CACHE_FILE=/app/cache.json
ENV PROXY_LOG_FILE=/app/proxy.log

EXPOSE 3001

CMD ["node", "server.mjs"]
