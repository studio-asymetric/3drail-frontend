{
  "name": "3drail-frontend",
  "version": "1.0.0",
  "description": "Live 3D map of trains on the Slovak network",
  "type": "commonjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copyProxyToDist.js",
    "preview": "vite preview",
    "proxy": "node proxy/server.mjs",
    "rails:close-holes": "node proxy/closeRailHoles.mjs",
    "rails:rebuild": "node proxy/closeRailHoles.mjs --rebuild",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.17",
    "pbf": "^5.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
